rules_version = '2';
// Cloud Firestore security rules for N-Back Pro.
// App uses the named database "nbackpro" (see sync_service.dart). You MUST deploy
// these rules to that database, or reads/writes will get PERMISSION_DENIED.
// From project root (nback_pro): firebase deploy --only firestore:rules
// Or in Console: Firestore > select database "nbackpro" > Rules > paste & Publish.

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write only their own data (settings, streak, sessions).
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
